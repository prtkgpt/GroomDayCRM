generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organization/Business account
model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique // URL-friendly identifier for public booking
  description     String?  // Business description for landing page
  theme           String   @default("blue") // Theme color for public pages
  logoUrl         String?  // Business logo for booking page
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  timezone        String   @default("America/Los_Angeles")
  businessHoursStart String @default("08:00") // 8am PST - earliest start time
  businessHoursEnd   String @default("17:00") // 5pm PST - latest start time (hard end is 8pm)
  appointmentBuffer  Int    @default(15) // minutes between appointments

  // Online booking settings
  bookingEnabled     Boolean @default(true)
  bookingLeadTime    Int     @default(2)   // minimum hours before appointment
  bookingMaxDaysAhead Int    @default(60)  // how far in advance can book
  bookingRequiresApproval Boolean @default(false) // require manual approval

  // Integration API keys (stored encrypted in production)
  stripeSecretKey     String?
  stripePublishableKey String?
  twilioAccountSid    String?
  twilioAuthToken     String?
  twilioPhoneNumber   String?
  resendApiKey        String?  // Optional override for org-specific email sending

  // Social & Review links
  googleReviewUrl     String?
  yelpUrl             String?
  facebookUrl         String?
  instagramUrl        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  clients         Client[]
  services        Service[]
  appointments    Appointment[]
  messageTemplates MessageTemplate[]
  messageLogs     MessageLog[]
  feedbacks       Feedback[]
  feedbackRequests FeedbackRequest[]
  recurringSchedules RecurringSchedule[]
  inventoryItems  InventoryItem[]
  staff           Staff[]
  waiverTemplates WaiverTemplate[]
  groomingNoteTemplates GroomingNoteTemplate[]
  invoices        Invoice[]
  waitlistEntries WaitlistEntry[]
}

// User account (linked to Clerk)
model User {
  id              String   @id @default(cuid())
  clerkId         String   @unique
  email           String   @unique
  firstName       String?
  lastName        String?
  role            UserRole @default(OWNER)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional staff profile link
  staffProfile    Staff?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

// Client (pet owner)
model Client {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  notes           String?
  tags            String[] // Simple array of tag strings

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pets            Pet[]
  appointments    Appointment[]
  sessions        CustomerSession[]
  feedbacks       Feedback[]
  feedbackRequests FeedbackRequest[]
  recurringSchedules RecurringSchedule[]
  waivers         ClientWaiver[]
  invoices        Invoice[]
  waitlistEntries WaitlistEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([lastName, firstName])
}

// Pet
model Pet {
  id              String   @id @default(cuid())
  name            String
  species         String   @default("Dog")
  breed           String?
  color           String?
  birthDate       DateTime?
  weight          Float?   // in pounds
  sex             String?  // Male, Female, Unknown

  // Grooming-specific info
  coatType        String?  // Short, Medium, Long, Double, Wire, Curly
  coatNotes       String?
  behaviorNotes   String?
  groomingPrefs   String?  // Special requests or preferences
  vaccineNotes    String?  // Vaccination info
  medicalNotes    String?

  photoUrl        String?

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  appointmentPets AppointmentPet[]
  vaccinations    VaccinationRecord[]
  recurringSchedulePets RecurringSchedulePet[]
  groomingNotes   GroomingNote[]
  waitlistPets    WaitlistPet[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
}

// Vaccination record for pets
model VaccinationRecord {
  id              String   @id @default(cuid())

  name            String   // e.g., "Rabies", "DHPP", "Bordetella"
  dateAdministered DateTime
  expirationDate  DateTime?

  // Document storage
  documentUrl     String?  // URL to uploaded document
  documentName    String?  // Original filename

  notes           String?

  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([petId])
  @@index([expirationDate])
}

// Service catalog
model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  defaultPrice    Float
  defaultDuration Int      // in minutes
  isAddOn         Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appointmentServices AppointmentService[]
  recurringScheduleServices RecurringScheduleService[]
  waitlistServices WaitlistService[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

// Appointment
model Appointment {
  id              String   @id @default(cuid())

  dateTime        DateTime
  duration        Int      // total duration in minutes

  status          AppointmentStatus @default(SCHEDULED)

  // Location info (for mobile groomers)
  locationType    LocationType @default(CLIENT_HOME)
  locationAddress String?
  locationNotes   String?

  notes           String?
  internalNotes   String?

  // Calculated totals
  subtotal        Float    @default(0)
  tipAmount       Float    @default(0)
  totalAmount     Float    @default(0)

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Recurring appointment link
  recurringScheduleId String?
  recurringSchedule   RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)

  // Assigned staff member
  staffId         String?
  staff           Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  // Relations
  appointmentPets AppointmentPet[]
  appointmentServices AppointmentService[]
  payment         Payment?
  messageLogs     MessageLog[]
  feedbacks       Feedback[]
  feedbackRequests FeedbackRequest[]
  inventoryUsage  InventoryUsage[]
  groomingNotes   GroomingNote[]
  invoice         Invoice?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, dateTime])
  @@index([clientId])
  @@index([recurringScheduleId])
  @@index([staffId])
}

enum AppointmentStatus {
  PENDING      // Waiting for groomer approval (online bookings)
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELED
}

enum LocationType {
  CLIENT_HOME
  BUSINESS
  OTHER
}

// Junction table for Appointment <-> Pet (many-to-many)
model AppointmentPet {
  id              String   @id @default(cuid())

  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  notes           String?

  createdAt       DateTime @default(now())

  @@unique([appointmentId, petId])
  @@index([appointmentId])
  @@index([petId])
}

// Junction table for Appointment <-> Service
model AppointmentService {
  id              String   @id @default(cuid())

  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Override prices per appointment
  price           Float
  duration        Int      // in minutes

  // Which pet is this service for (optional, for per-pet services)
  petId           String?

  notes           String?

  createdAt       DateTime @default(now())

  @@index([appointmentId])
  @@index([serviceId])
}

// Payment record
model Payment {
  id              String   @id @default(cuid())

  appointmentId   String   @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  amount          Float
  tipAmount       Float    @default(0)
  totalAmount     Float

  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  paidAt          DateTime?
  receiptNote     String?

  // For future Stripe integration
  stripePaymentId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  VENMO
  ZELLE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// Message templates
model MessageTemplate {
  id              String   @id @default(cuid())

  name            String   // e.g., "Booking Confirmation", "24h Reminder"
  type            MessageTemplateType
  subject         String?  // For emails
  body            String   // Template with placeholders like {{clientName}}, {{petName}}, etc.

  isActive        Boolean  @default(true)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

enum MessageTemplateType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  ON_MY_WAY
  THANK_YOU
  CUSTOM
}

// Log of sent messages
model MessageLog {
  id              String   @id @default(cuid())

  type            MessageType
  recipient       String   // Email or phone
  subject         String?
  body            String

  status          MessageStatus @default(SENT)
  sentAt          DateTime @default(now())

  // Optional links
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Provider info
  providerId      String?  // Resend message ID or Twilio SID

  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([appointmentId])
}

enum MessageType {
  EMAIL
  SMS
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// Customer portal session (magic link auth)
model CustomerSession {
  id              String   @id @default(cuid())

  // Magic link token (for login)
  token           String   @unique
  tokenExpiresAt  DateTime

  // Session token (after login)
  sessionToken    String?  @unique
  sessionExpiresAt DateTime?

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
  @@index([token])
  @@index([sessionToken])
}

// Customer feedback/reviews
model Feedback {
  id              String   @id @default(cuid())

  rating          Int      // 1-5 stars
  comment         String?  // Optional text feedback

  // Visibility
  isPublic        Boolean  @default(false) // Show on landing page?
  isApproved      Boolean  @default(false) // Owner approved for display?

  // Links
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([appointmentId])
}

// Feedback request tokens (for email links)
model FeedbackRequest {
  id              String   @id @default(cuid())

  token           String   @unique
  expiresAt       DateTime
  usedAt          DateTime? // When feedback was submitted

  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([token])
  @@index([organizationId])
  @@index([appointmentId])
}

// Recurring appointment schedule
model RecurringSchedule {
  id              String   @id @default(cuid())

  name            String?  // Optional friendly name like "Max's monthly groom"

  frequency       RecurrenceFrequency
  dayOfWeek       Int?     // 0=Sunday, 1=Monday, ... 6=Saturday (for WEEKLY/BIWEEKLY)
  dayOfMonth      Int?     // 1-31 (for MONTHLY)
  time            String   // HH:MM format (24-hour)

  duration        Int      // Total duration in minutes

  startDate       DateTime
  endDate         DateTime? // Optional end date

  // Location info
  locationType    LocationType @default(CLIENT_HOME)
  locationAddress String?
  locationNotes   String?

  notes           String?

  isActive        Boolean  @default(true)

  // Last generated appointment date (to track progress)
  lastGeneratedDate DateTime?

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  appointments    Appointment[]
  pets            RecurringSchedulePet[]
  services        RecurringScheduleService[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([isActive])
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// Junction table for RecurringSchedule <-> Pet
model RecurringSchedulePet {
  id                  String   @id @default(cuid())

  recurringScheduleId String
  recurringSchedule   RecurringSchedule @relation(fields: [recurringScheduleId], references: [id], onDelete: Cascade)

  petId               String
  pet                 Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())

  @@unique([recurringScheduleId, petId])
  @@index([recurringScheduleId])
  @@index([petId])
}

// Junction table for RecurringSchedule <-> Service
model RecurringScheduleService {
  id                  String   @id @default(cuid())

  recurringScheduleId String
  recurringSchedule   RecurringSchedule @relation(fields: [recurringScheduleId], references: [id], onDelete: Cascade)

  serviceId           String
  service             Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Override prices (optional)
  price               Float?
  duration            Int?     // in minutes

  createdAt           DateTime @default(now())

  @@unique([recurringScheduleId, serviceId])
  @@index([recurringScheduleId])
  @@index([serviceId])
}

// Inventory item (grooming supplies, products)
model InventoryItem {
  id              String   @id @default(cuid())

  name            String
  description     String?
  sku             String?  // Stock keeping unit
  category        String?  // e.g., "Shampoo", "Tools", "Accessories"

  // Stock tracking
  quantity        Int      @default(0)
  unit            String   @default("units") // e.g., "oz", "bottles", "units"
  lowStockThreshold Int    @default(5)

  // Cost and pricing
  costPrice       Float?   // What we pay for it
  sellPrice       Float?   // What we charge (if reselling)

  // Supplier info
  supplier        String?
  supplierSku     String?
  reorderUrl      String?

  isActive        Boolean  @default(true)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  transactions    InventoryTransaction[]
  usageRecords    InventoryUsage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([isActive])
}

// Inventory transaction (stock in/out)
model InventoryTransaction {
  id              String   @id @default(cuid())

  type            TransactionType
  quantity        Int      // Positive for additions, negative for removals
  notes           String?

  // For purchases
  unitCost        Float?
  totalCost       Float?
  invoiceNumber   String?

  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
}

enum TransactionType {
  PURCHASE      // Buying new stock
  ADJUSTMENT    // Manual stock adjustment
  RETURN        // Return to supplier
  DAMAGED       // Write-off damaged items
  USED          // Used in service (links to appointment)
  SOLD          // Sold to customer
}

// Inventory usage per appointment
model InventoryUsage {
  id              String   @id @default(cuid())

  quantity        Float    // Amount used (can be fractional, e.g., 2.5 oz of shampoo)

  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([itemId])
  @@index([appointmentId])
}

// Staff member (groomer)
model Staff {
  id              String   @id @default(cuid())

  firstName       String
  lastName        String
  email           String?
  phone           String?
  photoUrl        String?

  // Professional info
  title           String?  // e.g., "Senior Groomer", "Pet Stylist"
  bio             String?
  specialties     String[] // e.g., ["Large Dogs", "Cats", "Show Cuts"]

  // Employment
  hireDate        DateTime?
  hourlyRate      Float?
  commissionRate  Float?   // Percentage of service revenue

  // Colors for calendar display
  color           String   @default("#3b82f6") // Hex color for calendar

  isActive        Boolean  @default(true)

  // Optional link to User account (if they can log in)
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  appointments    Appointment[]
  schedules       StaffSchedule[]
  timeOff         StaffTimeOff[]
  waitlistEntries WaitlistEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
}

// Staff weekly schedule (availability)
model StaffSchedule {
  id              String   @id @default(cuid())

  dayOfWeek       Int      // 0=Sunday, 1=Monday, ... 6=Saturday
  startTime       String   // HH:MM format (24-hour)
  endTime         String   // HH:MM format (24-hour)
  isWorking       Boolean  @default(true)

  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

// Staff time off (vacation, sick days, etc.)
model StaffTimeOff {
  id              String   @id @default(cuid())

  startDate       DateTime
  endDate         DateTime
  reason          String?  // e.g., "Vacation", "Sick", "Personal"
  isApproved      Boolean  @default(true)
  notes           String?

  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId])
  @@index([startDate, endDate])
}

// ============================================
// DOCUMENTS & RECORDS
// ============================================

// Waiver template (liability, photo release, etc.)
model WaiverTemplate {
  id              String   @id @default(cuid())

  name            String   // e.g., "Liability Waiver", "Photo Release"
  content         String   // HTML/markdown content of the waiver
  isRequired      Boolean  @default(false) // Required for all clients?
  isActive        Boolean  @default(true)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  signatures      ClientWaiver[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

// Signed waiver record
model ClientWaiver {
  id              String   @id @default(cuid())

  signedAt        DateTime @default(now())
  signatureData   String   // Base64 signature image or typed name
  signatureType   SignatureType @default(TYPED)
  ipAddress       String?  // IP address when signed
  userAgent       String?  // Browser info when signed

  // Optional expiration (some waivers need annual renewal)
  expiresAt       DateTime?

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  templateId      String
  template        WaiverTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([clientId])
  @@index([templateId])
  @@index([expiresAt])
}

enum SignatureType {
  TYPED     // Typed name
  DRAWN     // Canvas-drawn signature
}

// Grooming notes template
model GroomingNoteTemplate {
  id              String   @id @default(cuid())

  name            String   // e.g., "Standard Bath Notes", "Full Groom Checklist"
  description     String?
  fields          Json     // Array of field definitions [{name, type, options, required}]
  isDefault       Boolean  @default(false) // Auto-apply to appointments?
  isActive        Boolean  @default(true)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  notes           GroomingNote[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

// Grooming note per appointment (linked to template)
model GroomingNote {
  id              String   @id @default(cuid())

  data            Json     // Filled-in field values from template
  additionalNotes String?  // Free-form additional notes

  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  templateId      String?
  template        GroomingNoteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdById     String?  // Staff who created the note

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([appointmentId])
  @@index([petId])
  @@index([templateId])
}

// Invoice
model Invoice {
  id              String   @id @default(cuid())

  invoiceNumber   String   // Auto-generated invoice number
  status          InvoiceStatus @default(DRAFT)

  // Dates
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  paidDate        DateTime?

  // Amounts
  subtotal        Float    @default(0)
  taxRate         Float    @default(0)    // Percentage
  taxAmount       Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float    @default(0)

  // Payment tracking
  amountPaid      Float    @default(0)
  balanceDue      Float    @default(0)

  // Notes
  notes           String?  // Notes shown on invoice
  internalNotes   String?  // Internal notes not shown to client

  // PDF storage
  pdfUrl          String?

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  appointmentId   String?  @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lineItems       InvoiceLineItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

// Invoice line item
model InvoiceLineItem {
  id              String   @id @default(cuid())

  description     String
  quantity        Float    @default(1)
  unitPrice       Float
  amount          Float    // quantity * unitPrice

  sortOrder       Int      @default(0)

  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Optional link to service
  serviceId       String?

  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

// ============================================
// WAITLIST MANAGEMENT
// ============================================

// Waitlist entry for clients wanting appointments
model WaitlistEntry {
  id              String   @id @default(cuid())

  // Preferred scheduling
  preferredDate   DateTime?  // Specific date they want
  preferredDayOfWeek Int[]   // Days they're available (0=Sun, 6=Sat)
  preferredTimeStart String? // Earliest time (HH:MM)
  preferredTimeEnd   String? // Latest time (HH:MM)

  // Flexibility
  isFlexibleDate  Boolean  @default(false) // Any date works
  isFlexibleTime  Boolean  @default(false) // Any time works

  // Request details
  notes           String?   // Client notes/special requests
  urgency         WaitlistUrgency @default(NORMAL)

  // Status tracking
  status          WaitlistStatus @default(ACTIVE)
  notifiedAt      DateTime? // Last time client was notified of opening
  notificationCount Int     @default(0)

  // Who was it offered to / filled by
  offeredSlotDate DateTime?
  respondByDate   DateTime? // Deadline to respond to offer

  // Relations
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Specific pet(s) for the appointment
  pets            WaitlistPet[]

  // Requested services
  services        WaitlistService[]

  // Preferred staff (optional)
  preferredStaffId String?
  preferredStaff  Staff?   @relation(fields: [preferredStaffId], references: [id], onDelete: SetNull)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([preferredDate])
}

enum WaitlistStatus {
  ACTIVE      // Waiting for opening
  NOTIFIED    // Client notified of available slot
  BOOKED      // Successfully booked
  EXPIRED     // No longer interested / too old
  CANCELLED   // Client cancelled request
}

enum WaitlistUrgency {
  LOW         // Flexible, no rush
  NORMAL      // Standard priority
  HIGH        // Needs appointment soon
  URGENT      // ASAP - vaccine expiring, etc.
}

// Junction: Waitlist entry <-> Pets
model WaitlistPet {
  id              String   @id @default(cuid())

  waitlistEntryId String
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)

  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([waitlistEntryId, petId])
  @@index([waitlistEntryId])
  @@index([petId])
}

// Junction: Waitlist entry <-> Services
model WaitlistService {
  id              String   @id @default(cuid())

  waitlistEntryId String
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)

  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([waitlistEntryId, serviceId])
  @@index([waitlistEntryId])
  @@index([serviceId])
}
